<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.38</WindowsSdkPackageVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace></RootNamespace>
    <AssemblyName>vbi</AssemblyName>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\..\Compilers\MicrosoftSharedPublicKey.snk</AssemblyOriginatorKeyFile>
    <ApplicationManifest>..\..\Interactive\vbi\app.manifest</ApplicationManifest>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Interactive\vbi\*.vb" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF"></FrameworkReference>
  </ItemGroup>

  <!--Region Windows app sdk-->
  <PropertyGroup>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants),USE_WINUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Nukepayload2.UI.VBWinUI3" Version="0.9.4-beta">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--End Region Windows app sdk-->

  <ItemGroup>
    <None Include="..\..\Interactive\vbi\vbi.coreclr.rsp">
      <Link>vbi.rsp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Scripting\VisualBasic\Microsoft.CodeAnalysis.VisualBasic.Scripting.vbproj" />
  </ItemGroup>
</Project>
