<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Nukepayload2.Compilers.VBScriptDotNet</PackageId>
    <Version>2.0.0-RC3</Version>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageDescription>Visual Basic compiler from the VBScriptDotNet fork, distributed as an MSBuild toolset package. Referencing it from a Visual Basic project redirects the Vbc task to the compiler bundled here: tasks/netcore for dotnet build, tasks/net472 for Visual Studio and MSBuild.exe. The package contains the Visual Basic compiler only; the C# path keeps using the compiler that ships with the SDK, and non-Visual-Basic projects are unaffected. Requires .NET SDK 10 (Core MSBuild) or .NET Framework 4.7.2+ with Visual Studio 2022 17.11+ (Full MSBuild). This is a development dependency; it does not replace the .NET SDK toolchain.</PackageDescription>
    <Authors>Nukepayload2</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_GetFiles</TargetsForTfmSpecificContentInPackage>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Compilers\VisualBasic\vbc\AnyCpu\vbc.csproj"
                      PrivateAssets="All" ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=$(TargetFramework)">
      <Targets Condition="'$(TargetFramework)' != 'net472'">Publish</Targets>
      <AdditionalProperties Condition="'$(TargetFramework)' != 'net472'">PublishDir=$(MSBuildThisFileDirectory)$(IntermediateOutputPath)vbc-publish\;SelfContained=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\Compilers\Core\MSBuildTask\MSBuild\Microsoft.Build.Tasks.CodeAnalysis.csproj"
                      PrivateAssets="All" ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=$(TargetFramework)">
      <Targets Condition="'$(TargetFramework)' != 'net472'">Publish</Targets>
      <AdditionalProperties Condition="'$(TargetFramework)' != 'net472'">PublishDir=$(MSBuildThisFileDirectory)$(IntermediateOutputPath)msbuildtask-publish\;SelfContained=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="build\**\*.*" PackagePath="build\" />
    <Content Include="buildMultiTargeting\**\*.*" PackagePath="buildMultiTargeting\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="_GetFiles" DependsOnTargets="Build">
    <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
      <_File Include="$(IntermediateOutputPath)msbuildtask-publish\Microsoft.Build.Tasks.CodeAnalysis.dll" TargetDir="tasks/netcore" />
      <_File Include="$(IntermediateOutputPath)msbuildtask-publish\Microsoft.*.targets" TargetDir="tasks/netcore" />
      <_File Include="$(IntermediateOutputPath)vbc-publish\vbc.dll" TargetDir="tasks/netcore/bincore" />
      <_File Include="$(IntermediateOutputPath)vbc-publish\vbc.deps.json" TargetDir="tasks/netcore/bincore" />
      <_File Include="$(IntermediateOutputPath)vbc-publish\vbc.runtimeconfig.json" TargetDir="tasks/netcore/bincore" />
      <_File Include="$(IntermediateOutputPath)vbc-publish\Microsoft.CodeAnalysis.dll" TargetDir="tasks/netcore/bincore" />
      <_File Include="$(IntermediateOutputPath)vbc-publish\Microsoft.CodeAnalysis.VisualBasic.dll" TargetDir="tasks/netcore/bincore" />
      <_File Include="$(IntermediateOutputPath)vbc-publish\**\Microsoft.CodeAnalysis.resources.dll" TargetDir="tasks/netcore/bincore" />
      <_File Include="$(IntermediateOutputPath)vbc-publish\**\Microsoft.CodeAnalysis.VisualBasic.resources.dll" TargetDir="tasks/netcore/bincore" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
      <_File Include="..\..\Compilers\Core\MSBuildTask\MSBuild\bin\$(Configuration)\net472\Microsoft.Build.Tasks.CodeAnalysis.dll" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\Core\MSBuildTask\MSBuild\bin\$(Configuration)\net472\Microsoft.Managed.Core.targets" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\Core\MSBuildTask\MSBuild\bin\$(Configuration)\net472\Microsoft.Managed.Core.CurrentVersions.targets" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\Core\MSBuildTask\MSBuild\bin\$(Configuration)\net472\Microsoft.VisualBasic.Core.targets" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\VisualBasic\vbc\AnyCpu\bin\$(Configuration)\net472\vbc.exe" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\VisualBasic\vbc\AnyCpu\bin\$(Configuration)\net472\vbc.exe.config" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\VisualBasic\vbc\AnyCpu\bin\$(Configuration)\net472\vbc.rsp" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\VisualBasic\vbc\AnyCpu\bin\$(Configuration)\net472\Microsoft.CodeAnalysis.dll" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\VisualBasic\vbc\AnyCpu\bin\$(Configuration)\net472\Microsoft.CodeAnalysis.VisualBasic.dll" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\VisualBasic\vbc\AnyCpu\bin\$(Configuration)\net472\**\*.resources.dll" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\VisualBasic\vbc\AnyCpu\bin\$(Configuration)\net472\System.*.dll" TargetDir="tasks/net472" />
      <_File Include="..\..\Compilers\VisualBasic\vbc\AnyCpu\bin\$(Configuration)\net472\Microsoft.DiaSymReader.Native.*.dll" TargetDir="tasks/net472" />
    </ItemGroup>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_File)" PackagePath="%(_File.TargetDir)/%(_File.RecursiveDir)%(_File.FileName)%(_File.Extension)" />
    </ItemGroup>
  </Target>
</Project>
