<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds the win RID folder of the vbi dotnet tool package.

  The tool package has one TFM root (tools/net10.0/) because PackAsTool rejects platform-specific TFMs
  (NETSDK1146: net10.0-windows / UseWindowsForms are not allowed for net5.0+). tools/net10.0/any/ is written
  by PackTool from the net10.0 publish; this file publishes the net10.0-windows TFM and injects it as
  tools/net10.0/win/, the variant the .NET CLI installs on Windows. Other platforms fall back to
  tools/net10.0/any/ (framework-dependent, no Windows Desktop dependency).

  Notes:
  - The RID folder name stays net10.0: the CLI resolves a RID variant per TFM
    (tools/<tfm>/<rid>/DotnetToolSettings.xml) and rejects a net10.0-windows folder for a net10.0 tool.
  - The folder is "win", not "win-x64": the CLI walks the RID graph (win-x64/win-x86/win-arm64 all import
    win, which imports any), so a single win folder serves every Windows architecture.
  - The publish is RID-less with UseAppHost=false, so the folder holds architecture-neutral managed IL only.
    The CLI generates the native vbi.exe launcher on the installing machine, so no per-architecture variant
    is needed here.
-->
<Project>
  <PropertyGroup>
    <!-- Fresh staging directory under obj: the packing glob must not pick up files left by an earlier pack
         (a stale DotnetToolSettings.xml would otherwise shadow the one below). -->
    <_VbiWinToolPublishDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\vbi-win-publish\</_VbiWinToolPublishDir>
    <TargetsForTfmSpecificContentInPackage Condition="'$(TargetFramework)' == 'net10.0'">$(TargetsForTfmSpecificContentInPackage);_PackVbiWinTool</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_PackVbiWinTool"
          Condition="'$(TargetFramework)' == 'net10.0' and '$(PackAsTool)' == 'true'">
    <RemoveDir Directories="$(_VbiWinToolPublishDir)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             Properties="TargetFramework=net10.0-windows;UseAppHost=false;SelfContained=false;Configuration=$(Configuration);PublishDir=$(_VbiWinToolPublishDir)">
      <Output TaskParameter="TargetOutputs" ItemName="_VbiWinToolPublishOutput" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_VbiWinToolPublishDir)**\*">
        <PackagePath>tools/net10.0/win/</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)ToolPack\win\DotnetToolSettings.xml">
        <PackagePath>tools/net10.0/win/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
