<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <VbiToolRid>any</VbiToolRid>
    <VbiToolTargetFramework>net10.0</VbiToolTargetFramework>
    <PackageId>Nukepayload2.Compilers.VBScriptDotNet.Cli.any</PackageId>
    <Authors>Nukepayload2</Authors>
    <PackageDescription>VBScriptDotNet vbi dotnet tool - RID-agnostic (any) payload. Install Nukepayload2.Compilers.VBScriptDotNet.Cli instead; this package is resolved automatically.</PackageDescription>
  </PropertyGroup>
  <Import Project="..\VbiToolPack.props" />
  <Import Project="..\VbiToolRidPackage.targets" />
</Project>
