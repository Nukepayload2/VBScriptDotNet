<Project>
  <PropertyGroup>
    <MicrosoftDotNetXliffTasksVersion>10.0.0-beta.26371.2</MicrosoftDotNetXliffTasksVersion>
    <ErrorOnOutOfDateXlf>false</ErrorOnOutOfDateXlf>
    <UpdateXlfOnBuild>false</UpdateXlfOnBuild>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">5.9.0</VersionPrefix>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">5.9.0.0</AssemblyVersion>
    <NoWarn>$(NoWarn);RSEXPERIMENTAL006</NoWarn>
    <!-- Warning parity with upstream Roslyn (see InternalDevDocs\upstream-merge.md).
         RS1041/RS1038: upstream eng\targets\Settings.props:65.
         Nullable diagnostics are only enforced on .NETCoreApp upstream: eng\targets\Imports.targets:41,66
         (DisableNullableWarnings -> NoWarn += Nullable). netstandard2.0/net48 reference assemblies carry
         no nullable annotations, so the same upstream source reports hundreds of CS86xx there otherwise.
         The condition tests the TFM (pivot: net5.0) rather than $(TargetFrameworkIdentifier): that property
         is still empty when Directory.Build.props is imported, so an identifier check would silence nullable
         diagnostics on .NET too.
         RS1036 is silenced the same way upstream does it: eng\targets\Settings.props:59.
         RS1024/RS1034/RS1014/RS2008/CA2265 severities live in WarningBaseline.globalconfig. -->
    <NoWarn>$(NoWarn);RS1041;RS1038</NoWarn>
    <NoWarn Condition="'$(TargetFramework)' != '' and !$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))">$(NoWarn);Nullable</NoWarn>
    <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
    <MoqPublicKey></MoqPublicKey>
    <MicrosoftSharedPublicKey></MicrosoftSharedPublicKey>
    <SignAssembly Condition="'$(MSBuildProjectName.StartsWith(`Microsoft.CodeAnalysis`))' == 'true' or '$(MSBuildProjectName)' == 'Roslyn.Test.PdbUtilities'">true</SignAssembly>
    <PublicSign Condition="'$(SignAssembly)' == 'true'">true</PublicSign>
    <AssemblyOriginatorKeyFile Condition="'$(SignAssembly)' == 'true' and '$(AssemblyOriginatorKeyFile)' == ''">$(MSBuildThisFileDirectory)Compilers\MicrosoftSharedPublicKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Global analyzer config: severities upstream keeps off for the compiler tree. -->
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)WarningBaseline.globalconfig" />
  </ItemGroup>

  <ItemDefinitionGroup Condition="'$(SignAssembly)' == 'true'">
    <InternalsVisibleTo>
      <Key>$(MicrosoftSharedPublicKey)</Key>
    </InternalsVisibleTo>
  </ItemDefinitionGroup>

  <PropertyGroup Condition="'$(Language)' == 'VB' or '$(MSBuildProjectExtension)' == '.vbproj'">
    <MyType>Empty</MyType>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>On</OptionStrict>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <VBRuntime Condition="'$(MSBuildProjectName)' == 'Microsoft.CodeAnalysis.VisualBasic'">Embed</VBRuntime>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Microsoft.CodeAnalysis' or '$(MSBuildProjectName)' == 'Microsoft.CodeAnalysis.VisualBasic' or '$(MSBuildProjectName)' == 'Microsoft.CodeAnalysis.Scripting' or '$(MSBuildProjectName)' == 'Microsoft.CodeAnalysis.VisualBasic.Scripting'">
    <PackageReference Include="Microsoft.DotNet.XliffTasks" Version="$(MicrosoftDotNetXliffTasksVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
